# Django
# Em dev, compose.dev.yaml força config.settings.dev
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_SECRET_KEY=troque-por-um-valor-aleatorio-com-50-caracteres
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000

# Banco (deixe vazio para SQLite em dev)
POSTGRES_DB=clareza
POSTGRES_USER=clareza
POSTGRES_PASSWORD=clareza
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# E-mail (dev usa console; Mailpit em http://localhost:8025)
EMAIL_URL=
DEFAULT_FROM_EMAIL=nao-responda@clareza.local

# Segurança (produção)
SECURE_SSL_REDIRECT=1
SECURE_HSTS_SECONDS=31536000
SESSION_COOKIE_SECURE=1
CSRF_COOKIE_SECURE=1

# Aplicação
APP_NAME=Clareza Financeira
APP_TIME_ZONE=America/Sao_Paulo
APP_CURRENCY=BRL
